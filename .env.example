# --- Database (matches docker-compose.yml; host port 5433) ---
DATABASE_URL=postgresql://copilot:copilot@localhost:5433/retirement_copilot

# --- MCP tool server (FastMCP, streamable-HTTP) ---
MCP_SERVER_URL=http://localhost:8100/mcp

# --- LLM (OpenAI). Leave OPENAI_API_KEY empty to run the deterministic
#     offline fallback synthesizer (demo still works with zero keys). ---
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint (e.g. a gateway). Leave empty
# to use api.openai.com.
OPENAI_BASE_URL=

# --- RAG / embeddings ---
# EMBED_MODEL is only used if sentence-transformers is installed; otherwise a
# deterministic hashed embedding of the SAME dimension is used automatically.
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIM=384
RAG_TOP_K=4

# --- Paths ---
# RAG_DOCS_DIR defaults to <project>/data/rag_docs and normally needs no override.
# RAG_DOCS_DIR=/absolute/path/to/data/rag_docs
